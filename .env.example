# Supabase Postgres: pooler (transaction mode) for the app, direct/session for migrations
DATABASE_URL=
DIRECT_URL=

# Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-1

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ALLOWED_EMAILS=

# Optional: only needed to run the signed-in Playwright specs in e2e/assist.spec.ts
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
