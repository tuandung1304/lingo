{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortTailwindcss": true,
  "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"]
}
